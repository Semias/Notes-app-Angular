POSTGRES_USER=notes_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=notes_db
POSTGRES_PORT=5432

# Used by goose (migrations) and by main.go at startup.
# Must match the three values above.
# sslmode=disable is safe only because this database is reachable on localhost.
DATABASE_URL=postgres://notes_user:change_me@localhost:5432/notes_db?sslmode=disable
